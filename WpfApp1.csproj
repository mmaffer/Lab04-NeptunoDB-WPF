<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <!-- System.Configuration.ConfigurationManager ya viene incluido en el SDK de escritorio de .NET,
         por eso no hace falta declararlo aquí (usamos ConfigurationManager para leer App.config). -->
  </ItemGroup>

</Project>
